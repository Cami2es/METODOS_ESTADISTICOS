#Ejercicio 1: Efimeras y Velocidad   speed <- 
c(2, 3, 5, 9, 14, 24, 29, 34)   abundance <- 
c(6, 3, 5, 23, 16, 12, 48, 43)  
#Diagramna de dispersion    
plot(speed, abundance,  
main="Relacion entre velocidad y abundancia",        
xlab="Speed",        
col="maroon")  
ylab="Abundance",        
pch=19, 
##Coeficiente de correlacion de pearson    
cor.test(speed, abundance,            
method ="pearson" )  
##   
##  Pearson's product-moment correlation  
##   
## data:  speed and abundance  
## t = 3.8568, df = 6, p-value = 0.008393  
## alternative hypothesis: true correlation is not equal to 0 
## 95 percent confidence interval: ##  0.3442317 0.9711386 ## 
sample estimates:  
##       cor  ## 
0.8441408  
##“Existe una correlación positiva entre la velocidad de los arroyos y la 
abundancia  
## de efímeras (Ecdyonurus dispar)”.  
    
    
    
